# Copy to .env and set a strong local password before starting PostgreSQL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ev_sharegrid
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional backend DSN. Leave empty to use the POSTGRES_* values above.
DATABASE_URL=

# URL of the AI Engine service.
AI_URL=http://localhost:8001

# JWT signing key: use a random secret of at least 32 bytes.
JWT_SECRET=
JWT_TTL_MINUTES=60

# JSON map of lowercase email to PBKDF2 hashes generated by backend.auth.hash_password.
AUTH_PASSWORD_HASHES_JSON=

# Local development only. Keep disabled in deployed environments.
DEV_AUTH_BYPASS=0
DEV_AUTH_USER_ID=3
