# Copy to .env for local use. Replace the password with a random local value.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_DB=ev_sharegrid

# AI Engine process settings; these are not secrets.
WORKERS=1
DEFAULT_TIME_BUDGET_MS=2000
DECOMPOSE_THRESHOLD=1000
LOG_LEVEL=info
