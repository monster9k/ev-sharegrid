# Copy to .env and replace this placeholder with a random local password.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_DB=ev_sharegrid
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional backend DSN. If set, this takes precedence over POSTGRES_*.
DATABASE_URL=

# Compose uses the internal service name. For a backend started directly on the
# host, change this to http://localhost:8001.
AI_URL=http://ai-engine:8001

# Generate a random JWT key with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_MINUTES=60

# Generate the JSON value with backend.auth.hash_password, for example:
# python -c "import json; from backend.auth import hash_password; print(json.dumps({'user1@sharegrid.vn': hash_password('replace-this-demo-password')}))"
AUTH_PASSWORD_HASHES_JSON=

# Local development only. Keep disabled in deployed environments.
DEV_AUTH_BYPASS=0
DEV_AUTH_USER_ID=3

# AI Engine process settings; these are non-secret configuration values.
WORKERS=1
DEFAULT_TIME_BUDGET_MS=10000
LARGE_SCENARIO_TIME_BUDGET_MS=2000
DECOMPOSE_THRESHOLD=250
LOG_LEVEL=info
