# Required: set POSTGRES_PASSWORD to a private random password.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ev_sharegrid
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional backend DSN. If set, this takes precedence over POSTGRES_*.
DATABASE_URL=

# Compose uses the internal service name. For a backend started directly on the
# host, change this to http://localhost:8001.
AI_URL=http://ai-engine:8001

# Optional backend CORS allowlist (comma-separated HTTPS origins).
CORS_ORIGINS=https://ev-sharegrid.web.app,https://ev-sharegrid.firebaseapp.com
# Optional extra origin pattern. Set to '' to disable regex matching.
CORS_ORIGIN_REGEX='^http://(localhost|127\.0\.0\.1)(:\d+)?$'

# Absolute container path for the read-only benchmark report mount.
BENCHMARK_REPORT_PATH=/app/ai_engine/benchmark_real.json

# Required: JWT_SECRET must contain at least 32 bytes. Run openssl rand -hex 32
# or use Python:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_MINUTES=60

# Required: install backend/requirements.txt, then run this from the repo root.
# Paste the output as a single-quoted value to preserve the $ in each hash.
# python -c "import getpass,json; from backend.auth import DEMO_EMAILS,hash_password; print(json.dumps({e:hash_password(getpass.getpass(e+' password: ')) for e in DEMO_EMAILS}))"
AUTH_PASSWORD_HASHES_JSON=

# Local development only. Keep disabled in deployed environments.
DEV_AUTH_BYPASS=0
DEV_AUTH_USER_ID=3

# AI Engine process settings; these are non-secret configuration values.
WORKERS=1
DEFAULT_TIME_BUDGET_MS=10000
LARGE_SCENARIO_TIME_BUDGET_MS=2000
DECOMPOSE_THRESHOLD=250
LOG_LEVEL=info
