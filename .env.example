# Copy to .env and set a strong local password before starting PostgreSQL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ev_sharegrid
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional backend DSN. Leave empty to use the POSTGRES_* values above.
DATABASE_URL=

# URL of the AI Engine service.
AI_URL=http://localhost:8001
