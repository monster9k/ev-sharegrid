# Flutter 3.44.0 from the upstream stable multi-platform image.
FROM ghcr.io/cirruslabs/flutter:stable@sha256:46691e311715845de03a3ba4753a475476936805b29431b1f00f1816981033f8 AS build
WORKDIR /app
COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get --enforce-lockfile
COPY lib lib
COPY web web
COPY assets assets
COPY ai_engine/samples/page20_input.json ai_engine/samples/page20_input.json
ARG API_BASE_URL=""
RUN flutter build web --release --no-pub --dart-define=API_BASE_URL="${API_BASE_URL}"

FROM nginx:alpine
COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build/web /usr/share/nginx/html
EXPOSE 80
